plugin {
  tx_pongback {
    view {
      templateRootPaths {
        0 = EXT:pongback/Resources/Private/Templates/
        1 = {$plugin.tx_pongback.view.templateRootPath}
      }

      partialRootPaths {
        0 = EXT:pongback/Resources/Private/Partials/
        1 = {$plugin.tx_pongback.view.partialRootPath}
      }

      layoutRootPaths {
        0 = EXT:pongback/Resources/Private/Layouts/
        1 = {$plugin.tx_pongback.view.layoutRootPath}
      }
    }

    persistence {
      storagePid = {$plugin.tx_pongback.persistence.storagePid}
    }
    settings {
      listItem = 2
    }
  }
}

pingback = PAGE
pingback {
  typeNum = 1709405325110
  10 < tt_content.list.20.pongback_server
  config {
    disableAllHeaderCode = 1
    additionalHeaders {
      10 {
        header = Content-type:text/xml
        replace = 1
        httpResponseCode = 404
      }
    }

    xhtml_cleaning = 0
    debug = 0
    no_cache = 1
    admPanel = 0
  }
}
