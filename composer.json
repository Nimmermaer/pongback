{
	"name": "webicorns/pongback",
	"description": "TYPO3 extension for sending and receiving Pingbacks",
	"keywords": [
		"TYPO3",
		"extension",
		"pingback",
		"blog"
	],
	"type": "typo3-cms-extension",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Michael Blunck",
			"email": "michael.blunck@webicorns.com",
			"role": "developer"
		},
		{
			"name": "Philipp Thiele",
			"email": "philipp.thiele@webicorns.com",
			"role": "Product manager"
		}
	],
	"support": {
		"docs": "https://docs.typo3.org/p/webicorns/pongback/main/en-us/",
		"issues": "https://github.com/Nimmermaer/pongback/issues",
		"source": "https://github.com/Nimmermaer/pongback"
	},
	"require": {
		"php": "^8.2",
		"ext-dom": "*",
		"ext-libxml": "*",
		"ext-simplexml": "*",
		"guzzlehttp/guzzle": "^7.16 || ^8.3",
		"guzzlehttp/psr7": "^2.13 || ^3.1",
		"symfony/rate-limiter": "^7.4",
		"typo3/cms-backend": "^13.4 || ^14.0",
		"typo3/cms-core": "^13.4 || ^14.0",
		"typo3/cms-extbase": "^13.4 || ^14.0",
		"typo3/cms-fluid": "^13.4 || ^14.0",
		"typo3/cms-frontend": "^13.4 || ^14.0",
		"typo3/cms-webhooks": "^13.4 || ^14.0"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.64",
		"infection/infection": "^0.29",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11.5",
		"ssch/typo3-rector": "^3.0",
		"typo3/cms-dashboard": "^13.4 || ^14.0",
		"typo3/testing-framework": "^9.0"
	},
	"suggest": {
		"typo3/cms-dashboard": "Provides the \"Latest Pingbacks\" dashboard widget"
	},
	"autoload": {
		"psr-4": {
			"Webicorns\\Pongback\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Webicorns\\Pongback\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true,
			"infection/extension-installer": false
		},
		"bin-dir": ".Build/bin",
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "pongback",
			"version": "0.9.0",
			"Package": {
				"providesPackages": {}
			},
			"web-dir": ".Build/public"
		}
	},
	"scripts": {
		"ci:cgl": "php-cs-fixer fix --dry-run --diff",
		"ci:phpstan": "phpstan analyse --no-progress",
		"ci:rector": "rector process --dry-run",
		"ci:tests:functional": "phpunit -c Build/phpunit/FunctionalTests.xml",
		"ci:tests:mutation": "infection --threads=max --no-progress --only-covered",
		"ci:tests:unit": "phpunit",
		"fix:cgl": "php-cs-fixer fix",
		"fix:rector": "rector process"
	}
}
